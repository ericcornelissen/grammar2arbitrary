{
  "name": "@ericcornelissen/grammar2arbitrary",
  "version": "0.1.0",
  "description": "Generate fast-check arbitraries from a grammar",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "grammar2arbitrary": "bin.js"
  },
  "man": "./man.1",
  "engines": {
    "node": "^26"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericcornelissen/grammar2arbitrary.git"
  },
  "bugs": {
    "url": "https://github.com/ericcornelissen/grammar2arbitrary/issues"
  },
  "author": {
    "name": "Eric Cornelissen",
    "email": "ericornelissen@gmail.com",
    "url": "https://ericcornelissen.dev/"
  },
  "keywords": [
    "arbitrary",
    "fast-check",
    "grammar",
    "generator"
  ],
  "dependencies": {
    "ohm-js": "^17.0.3"
  },
  "peerDependencies": {
    "fast-check": "^4.8.0"
  },
  "devDependencies": {
    "eslint": "10.6.0",
    "eslint-node-test": "0.2.0",
    "npm-run-all2": "9.0.2",
    "prettier": "3.9.5",
    "semver": "7.8.5"
  },
  "scripts": {
    "_prettier": "prettier  --ignore-path .gitignore '**/*.{js,json,md,yml}'",
    "check": "npm-run-all check:*",
    "check:config": "node script/check-eslint-rules.js",
    "check:formatting": "npm run _prettier -- --check",
    "check:js": "eslint --config .eslint.js '*.js'",
    "clean": "git clean -fx node_modules/ testdata/*.js",
    "format": "npm run _prettier -- --write",
    "test": "npm-run-all test:*",
    "test:bin": "node --test bin.test.js",
    "test:unit": "node --test main.test.js",
    "verify": "npm run check && npm run test",
    "version-bump": "node script/version-bump.js"
  }
}
